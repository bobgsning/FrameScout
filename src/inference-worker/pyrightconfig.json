{
  // 与工作区根级 pyrightconfig.json 保持一致（venvPath/extraPaths 因相对基准不同而不同）。
  "typeCheckingMode": "standard",
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": ["."],
  "reportImplicitRelativeImport": false,
  "exclude": [
    "**/dist",
    "**/build",
    "**/models",
    "**/target",
    "**/__pycache__",
    "**/node_modules",
    "**/.venv"
  ]
}
